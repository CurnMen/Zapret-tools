{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Zapret Tools",
  "version": "1.0.0",
  "identifier": "com.zapret.tools",
  "build": { "frontendDist": "../src" },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Zapret Tools",
        "width": 1100,
        "height": 850,
        "resizable": true,
        "dragDropEnabled": true
      }
    ],
    "security": { "csp": null }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/example/zapret-tools/releases/latest/download/latest.json"
      ],
      "pubkey": "AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "resources": {
      "../google-10000-english.txt": "dictionaries/google-10000-english.txt",
      "../100_000_russian_wordlist.txt": "dictionaries/100_000_russian_wordlist.txt"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}